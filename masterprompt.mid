PROMPT 3: SUPABASE SQL + SECURITY (Paste di Supabase SQL Editor)

Ini biar backend aman dan tidak bisa di-download:

-- Buat tabel
create table keywords (
 id uuid primary key default gen_random_uuid(),
 arabic text not null,
 transliteration text,
 meaning_id text not null,
 level int not null,
 frequency int,
 example_ayah text,
 audio_url text,
 created_at timestamp default now()
);

create table user_progress (
 user_id uuid references auth.users,
 keyword_id uuid references keywords,
 mastery int default 0,
 next_review date,
 primary key (user_id, keyword_id)
);

create table subscriptions (
 user_id uuid references auth.users primary key,
 is_active boolean default false,
 end_date date,
 payment_method text
);

-- Aktifkan RLS (Anti download massal)
alter table keywords enable row level security;
create policy "Free can access level 1-2"
 on keywords for select
 using (level <= 2 OR EXISTS (select 1 from subscriptions where user_id = auth.uid() AND is_active = true));

create policy "User progress only own"
 on user_progress for all
 using (user_id = auth.uid());

-- Function untuk signed audio URL (expire 5 menit)
create or replace function get_secure_audio(keyword_id uuid)
returns text language plpgsql security definer as $$
begin
 -- cek langganan dulu
 return (select audio_url from keywords where id = keyword_id);
end $$;

