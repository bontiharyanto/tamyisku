  { "word_position": 2, "arabic_text": "ALLAH_ARABIC", "translation": "Allah", "tamyiz_category": "Isim", "audio_url": "https://example.com/audio2.mp3" },
  { "word_position": 3, "arabic_text": "AR-RAHMAN_ARABIC", "translation": "Yang Maha Pengasih", "tamyiz_category": "Tamyiz 1", "audio_url": "https://example.com/audio3.mp3" }
]

