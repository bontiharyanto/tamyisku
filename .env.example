EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_PAYMENTS_MODE=sandbox
EXPO_PUBLIC_WEB_URL=http://localhost:8080
# Digits only, country code included. Example: 6281234567890
EXPO_PUBLIC_SUPPORT_WHATSAPP=

# Edge Function secret, never in the app:
# SUPPORT_WEBHOOK_URL=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# GOOGLE_TTS_API_KEY=

# Local Docker (see DOCKER.md): http://localhost:54321
# The anon key is printed by `npx supabase status`.

# Edge Function secrets (set with `supabase secrets set`, never in the app):
# PAYMENT_GATEWAY=midtrans
# MIDTRANS_SERVER_KEY=
# MIDTRANS_IS_PRODUCTION=false
# XENDIT_SECRET_KEY=
# XENDIT_CALLBACK_TOKEN=
